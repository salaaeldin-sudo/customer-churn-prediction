   "source": [
    "## 5. Train/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "be38e9e8",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-08T08:33:32.240813Z",
