   "source": [
    "# CustomerID is just a label, not a predictive feature -> drop it\n",
    "model_df = df.drop(columns=[\"CustomerID\"]).copy()\n",
    "\n",
    "# turn the target into numbers: churned = 1, stayed = 0\n",
    "model_df[\"Churn\"] = model_df[\"Churn\"].map({\"Yes\": 1, \"No\": 0})\n",
    "\n",
    "# one-hot encode the categorical features, output as 0/1 instead of True/False\n",
    "X = pd.get_dummies(\n",
    "    model_df.drop(columns=[\"Churn\"]),\n",
    "    drop_first=True,\n",
    "    dtype=int\n",
    ")\n",
    "\n",
    "y = model_df[\"Churn\"]     # y = what we're predicting, X = everything we predict it from\n",
    "\n",
    "print(\"Feature matrix shape after encoding:\", X.shape)\n",
    "X.head(3)"
   ]
